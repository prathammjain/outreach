# ── Gumroad Configuration ─────────────────────────────────────────────────────
# Get your seller ID from Gumroad Settings → Advanced → API
GUMROAD_SELLER_ID=your_gumroad_seller_id

# Product permalinks (the short code in each Gumroad product URL)
GUMROAD_INDIAN_PERMALINK=indian-startups-db
GUMROAD_YC_PERMALINK=yc-database
GUMROAD_UK_PERMALINK=uk-database

# ── Google Service Account ────────────────────────────────────────────────────
# Option A – local dev: path to JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Option B – production: base64-encoded JSON (run: base64 -i service-account.json)
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# ── Database ──────────────────────────────────────────────────────────────────
# /data is the mounted Railway volume; use sqlite:///./payments.db for local dev
DATABASE_URL=sqlite:////data/payments.db

# ── Google Sheet IDs ──────────────────────────────────────────────────────────
INDIAN_SHEET_ID=your_indian_sheet_id_here
YC_SHEET_ID=your_yc_sheet_id_here
UK_SHEET_ID=your_uk_sheet_id_here

# ── Admin / Security ─────────────────────────────────────────────────────────
# Any strong random string; sent as X-Admin-Key header when calling /admin/revoke
ADMIN_API_KEY=generate_a_strong_random_key_here

# Comma-separated list of your frontend domain(s) for CORS
# Leave empty to allow all origins (dev only)
ALLOWED_ORIGINS=https://your-frontend-domain.com
